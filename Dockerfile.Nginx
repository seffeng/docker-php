FROM seffeng/nginx:1.30 AS nginx

FROM php-supervisor:8.5-ext-slim

LABEL author="seffeng"
LABEL description="build php and nginx environment base alpine linux"

COPY --from=nginx / /

ARG BASE_DIR="/opt/websrv"

ENV CONFIG_DIR="${BASE_DIR}/config"\
 WWWROOT_DIR="${BASE_DIR}/data/wwwroot"

WORKDIR /tmp
COPY    conf ./conf
COPY errors ${WWWROOT_DIR}/errors

RUN \
 mkdir -p ${BASE_DIR}/logs/php ${BASE_DIR}/logs/nginx &&\
 cp -Rf /tmp/conf/nginx/* ${CONFIG_DIR}/nginx &&\
 cp -Rf /tmp/conf/php/* ${CONFIG_DIR}/php &&\
 cp -Rf /tmp/conf/supervisor/* /etc/supervisor.d &&\
 rm -rf /var/cache/apk/* &&\
 rm -rf /tmp/*

VOLUME ["${BASE_DIR}/logs/nginx", "${BASE_DIR}/logs/php", "${BASE_DIR}/logs/supervisord"]

EXPOSE 80 443

CMD ["supervisord", "-c", "/etc/supervisord.conf"]
